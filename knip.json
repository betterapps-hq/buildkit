{
  "ignoreExportsUsedInFile": true,
  "ignore": ["**/src/vendor/**"],
  "workspaces": {
    "apps/docs": {
      "entry": ["scripts/generate.ts", "content/.vitepress/config.ts", "content/.vitepress/theme/index.ts"]
    },
    "apps/site": {
      "entry": ["src/main.tsx", "src/prerender.tsx", "vite.config.ts"]
    },
    "packages/tooling/api-tools": {
      "entry": ["src/reports.ts"]
    },
    "packages/tooling/api-mocker": {
      "entry": ["src/index.ts"]
    },
    ".": {
      "entry": ["beachball.config.js"]
    },
    "packages/core/typescript-utils": {
      "entry": ["src/index.ts", "src/reset.ts", "test/consumer/*.ts", "test/consumer-types/*.ts"]
    },
    "packages/tooling/storybook-config": {
      "entry": ["src/main.ts", "src/preview.ts", "src/ExampleFrame.tsx"],
      "ignoreDependencies": ["@chromatic-com/storybook", "@storybook/addon-a11y", "@storybook/addon-vitest"]
    },
    "packages/tooling/scaffolder": {
      "entry": [
        "src/core.ts",
        "src/edit.ts",
        "src/edit-code.ts",
        "src/node.ts",
        "src/cli.ts",
        "src/bin.ts",
        "vitest.integration.config.ts"
      ]
    },
    "packages/tooling/catalog": {
      "entry": ["src/index.ts"],
      "ignore": ["templates/**"]
    },
    "packages/tooling/cli": {
      "entry": ["src/index.ts", "src/bin.ts", "vitest.integration.config.ts"]
    },
    "packages/tooling/dev-domains": {
      "entry": [
        "src/cli/main.ts",
        "src/config/schema.ts",
        "src/node.ts",
        "src/playwright.ts",
        "vitest.integration.config.ts"
      ]
    },
    "packages/core/modal-core": {
      "entry": ["src/index.ts"]
    },
    "packages/react/react-modals": {
      "entry": ["src/index.ts"]
    },
    "packages/fluentui/fluentui-modals-manager": {
      "entry": ["src/index.tsx"]
    },
    "packages/shadcn/shadcn-modals-manager": {
      "entry": ["src/index.tsx", "src/styles.ts"]
    },
    "packages/core/alert-core": {
      "entry": ["src/index.ts"]
    },
    "packages/react/react-alerts": {
      "entry": ["src/index.ts"]
    },
    "packages/shadcn/shadcn-alerts-manager": {
      "entry": ["src/index.tsx", "src/styles.ts"]
    },
    "packages/fluentui/fluentui-alerts-manager": {
      "entry": ["src/index.tsx"]
    },
    "packages/core/router-core": {
      "entry": ["src/index.ts"]
    },
    "packages/react/react-routing": {
      "entry": ["src/index.ts"]
    },
    "packages/react/react-router": {
      "entry": ["src/index.ts"]
    },
    "packages/react/tanstack-router": {
      "entry": ["src/index.ts"]
    },
    "packages/core/configuration-core": {
      "entry": ["src/index.ts"]
    },
    "packages/react/react-configuration": {
      "entry": ["src/index.ts"]
    },
    "packages/tooling/shadcn-generator": {
      "entry": ["src/*.mjs"],
      "ignoreDependencies": ["@tailwindcss/cli", "tailwindcss", "tw-animate-css"]
    },
    "packages/shadcn/shadcn-baseui-luma": {
      "entry": [".generated/index.ts"],
      "ignoreDependencies": ["@repo/shadcn-generator", "lucide-react", "next-themes"]
    },
    "packages/shadcn/shadcn-baseui-lyra": {
      "entry": [".generated/index.ts"],
      "ignoreDependencies": ["@repo/shadcn-generator", "lucide-react", "next-themes"]
    },
    "packages/shadcn/shadcn-baseui-maia": {
      "entry": [".generated/index.ts"],
      "ignoreDependencies": ["@repo/shadcn-generator", "lucide-react", "next-themes"]
    },
    "packages/shadcn/shadcn-baseui-mira": {
      "entry": [".generated/index.ts"],
      "ignoreDependencies": ["@repo/shadcn-generator", "lucide-react", "next-themes"]
    },
    "packages/shadcn/shadcn-baseui-nova": {
      "entry": [".generated/index.ts"],
      "ignoreDependencies": ["@repo/shadcn-generator", "lucide-react", "next-themes"]
    },
    "packages/shadcn/shadcn-baseui-rhea": {
      "entry": [".generated/index.ts"],
      "ignoreDependencies": ["@repo/shadcn-generator", "lucide-react", "next-themes"]
    },
    "packages/shadcn/shadcn-baseui-sera": {
      "entry": [".generated/index.ts"],
      "ignoreDependencies": ["@repo/shadcn-generator", "lucide-react", "next-themes"]
    },
    "packages/shadcn/shadcn-baseui-vega": {
      "entry": [".generated/index.ts"],
      "ignoreDependencies": ["@repo/shadcn-generator", "lucide-react", "next-themes"]
    },
    "packages/tooling/oxlint-plugin-anti-slop": {
      "entry": ["src/index.ts", "src/recommended.ts", "test/fixture/*.ts"]
    },
    "packages/tooling/oxlint-config": {
      "entry": ["src/anti-slop.ts"]
    }
  }
}
