{
  "name": "buildkit",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "^24.11.0 || >=26.0.0",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "build": "vp run --cache --filter \"./packages/**\" --filter \"./apps/**\" build",
    "build:packages": "vp run --cache --filter \"./packages/**\" build",
    "dev": "vp run --parallel --filter \"./apps/**\" dev",
    "verify": "pnpm check && pnpm check:unused && pnpm check:api && pnpm test:coverage && pnpm build",
    "check": "pnpm build:packages && vp check",
    "check:api": "pnpm build:packages && pnpm --filter @buildkitgg/api-tools api:check",
    "api:update": "pnpm build:packages && pnpm --filter @buildkitgg/api-tools api:update",
    "format": "vp fmt",
    "check:unused": "knip",
    "test": "pnpm build:packages && vp run --cache --filter \"./packages/**\" --filter \"./apps/**\" test",
    "test:coverage": "pnpm build:packages && vp run --cache --filter \"./packages/**\" --filter \"./apps/**\" test:coverage",
    "change": "beachball change",
    "check:change": "beachball check",
    "prepare": "vp config --no-agent",
    "update:shadcn": "pnpm --filter @buildkitgg/shadcn-generator update:shadcn",
    "generate": "pnpm --filter @buildkitgg/shadcn-generator generate && pnpm install",
    "validate": "pnpm verify && pnpm --filter @buildkitgg/shadcn-generator validate",
    "guidance:sync": "playbook-sync",
    "guidance:check": "playbook-sync --check",
    "guidance:update": "pnpm update @betterapps/playbook --latest && playbook-sync",
    "skills:add": "skills add",
    "skills:update": "skills update -p",
    "skills:remove": "skills remove",
    "skills:check": "skills check",
    "skills:sync": "skills add betterapps-hq/playbook --skill \"*\" -a codex claude-code github-copilot --yes",
    "rules:import": "rulesync import"
  },
  "devDependencies": {
    "beachball": "^2.65.5",
    "knip": "^6.43.0",
    "vite-plus": "catalog:",
    "@betterapps/playbook": "github:betterapps-hq/playbook",
    "rulesync": "43.5.0",
    "skills": "1.7.6"
  }
}
