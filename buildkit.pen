                {
                  "type": "text",
                  "id": "Cu8oG",
                  "name": "Why",
                  "fill": "$text-2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Vanilla core, framework and libraries as three floating layers. Reads as a stack at any size, works in one color because the gaps carry the shape, and leads straight into the layer motion on the page.",
