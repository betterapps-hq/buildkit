{
  "name": "@buildkitgg/typescript-utils",
  "version": "0.0.0",
  "description": "A curated set of TypeScript utilities: es-toolkit, ts-extras, ts-pattern, type-fest, tiny-invariant and ts-reset behind one import.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reset": {
      "types": "./dist/reset.d.ts",
      "import": "./dist/reset.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "AGENTS.md",
    "reexports.json",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "generate": "node scripts/generate.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "node scripts/generate.ts --check && tsc -p test/consumer && tsc -p test/consumer-types && vp test run",
    "test:coverage": "node scripts/generate.ts --check && tsc -p test/consumer && tsc -p test/consumer-types && vp test run --coverage",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@total-typescript/ts-reset": "0.6.1",
    "es-toolkit": "1.53.1",
    "tiny-invariant": "1.3.3",
    "ts-extras": "1.3.0",
    "ts-pattern": "5.9.2",
    "type-fest": "5.10.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.4",
    "@buildkitgg/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewCraswell/buildkit.git",
    "directory": "packages/core/typescript-utils"
  },
  "homepage": "https://github.com/AndrewCraswell/buildkit/tree/main/packages/core/typescript-utils#readme",
  "bugs": {
    "url": "https://github.com/AndrewCraswell/buildkit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
